# SwiftHealth CI Integration Example
# ===================================
# Copy this file to your project's .github/workflows/health-check.yml
#
# Features:
# - Automatic health checks on PRs and pushes
# - PR comments with score and emoji indicators
# - Artifact storage for historical tracking
# - Optional: Block PRs if health score drops significantly
#
# Configuration:
# - Set HEALTH_THRESHOLD variable in repository settings (default: 70)
# - Requires: Homebrew tap installed (nemanjavlahovic/tap/swifthealth)

name: Health Check

on:
  pull_request:
    branches: [main, develop]
  push:
    branches: [main]
  # Optional: Scheduled weekly health check
  # schedule:
  #   - cron: '0 9 * * 1'  # Every Monday at 9am UTC

jobs:
  health-check:
    name: Analyze Project Health
    runs-on: macos-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Full history for accurate git metrics

      - name: Setup Swift
        uses: swift-actions/setup-swift@v2
        with:
          swift-version: '5.9'

      - name: Install SwiftHealth
        run: |
          brew tap nemanjavlahovic/tap
          brew install swifthealth

      - name: Run Health Analysis
        id: health
        run: |
          # Run analysis with JSON output
          swifthealth analyze \
            --format json \
            --json-out health-report.json \
            --fail-under ${{ vars.HEALTH_THRESHOLD || 70 }}

          # Extract score and band for PR comment
          SCORE=$(jq '.score' health-report.json)
          BAND=$(jq -r '.band' health-report.json)

          echo "score=$SCORE" >> $GITHUB_OUTPUT
          echo "band=$BAND" >> $GITHUB_OUTPUT

      - name: Upload Health Report
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: health-report
          path: health-report.json
          retention-days: 30

      - name: Comment on PR
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const score = '${{ steps.health.outputs.score }}';
            const band = '${{ steps.health.outputs.band }}';

            // Choose emoji based on health band
            const emoji = {
              'green': '🟢',
              'yellow': '🟡',
              'orange': '🟠',
              'red': '🔴'
            }[band] || '⚪';

            const status = {
              'green': 'Excellent',
              'yellow': 'Good',
              'orange': 'Fair',
              'red': 'Needs Attention'
            }[band] || 'Unknown';

            // Create or update comment
            const body = `## ${emoji} Health Score: ${score}/100

**Status:** ${status}

<details>
<summary>View Details</summary>

Download the full report from [workflow artifacts](${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}).

**What is SwiftHealth?**
SwiftHealth analyzes your Swift/iOS project and provides a health score based on:
- Git activity and commit quality
- Code metrics (LOC, comment density, file sizes)
- Linting violations (if SwiftLint configured)
- Dependency freshness
- Dead code detection (if Periphery configured)

</details>

---
<sub>Generated by [SwiftHealth](https://github.com/nemanjavlahovic/swifthealth)</sub>`;

            // Find existing comment
            const { data: comments } = await github.rest.issues.listComments({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number
            });

            const existingComment = comments.find(c =>
              c.user.login === 'github-actions[bot]' &&
              c.body.includes('Health Score:')
            );

            if (existingComment) {
              // Update existing comment
              await github.rest.issues.updateComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                comment_id: existingComment.id,
                body: body
              });
            } else {
              // Create new comment
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.issue.number,
                body: body
              });
            }

  # Optional: Health Gate - Block PRs that significantly degrade health
  # Uncomment this job to enable regression detection
